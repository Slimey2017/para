+  const rows = manifest.layout?.rows || 3;
+  const gap = manifest.layout?.gap ?? 18;
+  const backgroundStyle = manifest.background ? "" : `background:radial-gradient(circle at 50% 10%,${manifest.accent}33,transparent 45%),#08070c;`;
